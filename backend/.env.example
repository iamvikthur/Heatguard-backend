PORT=5500
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heatguard?schema=public
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
LLM_API_KEY=
STT_API_KEY=
# Password given to the seeded demo users (dev only)
SEED_PASSWORD=
# Minutes between automatic risk runs. 0 disables the timer.
RISK_INTERVAL_MIN=15

# ai/.env  (gitignored)
OPENAI_API_KEY=...
OPENAI_INTAKE_MODEL=...
OPENAI_STT_MODEL=gpt-transcribe
# Web app origin(s), comma separated. Unset: any localhost port is allowed (development only).
WEB_ORIGIN=
# Base URL of the web app, used in worker sign-in links.
WEB_BASE_URL=http://localhost:3000
